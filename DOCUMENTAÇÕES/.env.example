# ⚠️ TEMPLATE .env - PORTAL DO FUNCIONÁRIO
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env na raiz do projeto
# 2. Substitua os valores de exemplo com valores SEGUROS e REAIS
# 3. NUNCA commit este arquivo no Git (já está em .gitignore)
# 4. Cada ambiente (dev, staging, prod) deve ter seu próprio .env
#
# ⚠️ SEGURANÇA: As chaves precisam ser:
#    - Únicas por ambiente
#    - Complexas (letras, números, símbolos especiais, 32+ caracteres)
#    - Diferentes entre dev/staging/prod
#    - Nunca compartilhadas ou loggadas

# ============================================================================
# SEGURANÇA - CHAVES E TOKENS
# ============================================================================

# Chave secreta do Flask (para cookies, session, csrf)
# Gere com: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=seu-chave-secreta-muito-longa-e-complexa-aqui-nao-use-esta-exemplo

# Chave secreta para administrador (ativação de empresas, etc)
# Use valor diferente e seguro
CHAVE_SECRETA_ADMIN=chave-admin-super-secreta-nao-use-exemplo

# ============================================================================
# BANCO DE DADOS
# ============================================================================

# URL de conexão PostgreSQL
# Formato: postgresql+psycopg2://usuario:senha@host:porta/banco_dados
# 
# Exemplo DEV (local):
#   DATABASE_URL=postgresql+psycopg2://postgres:senha_local@localhost:5432/portal_funcionario
#
# Exemplo PROD (servidor):
#   DATABASE_URL=postgresql+psycopg2://user_prod:senha_super_segura@servidor.com:5432/portal_prod
#
DATABASE_URL=postgresql+psycopg2://postgres:sua_senha_aqui@localhost:5432/portal_funcionario

# ============================================================================
# FLASK ENVIRONMENT
# ============================================================================

# Ambiente de execução: development, testing, production
FLASK_ENV=development

# Debug mode (NUNCA use True em produção!)
# development: True (código recarrega automaticamente)
# production: False (segurança)
FLASK_DEBUG=1

# ============================================================================
# APLICAÇÃO
# ============================================================================

# URL base da aplicação (para email links, redirects, etc)
APP_URL=http://localhost:5000

# ============================================================================
# EMAIL (Opcional - para notificações futura)
# ============================================================================

# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=seu-email@gmail.com
# MAIL_PASSWORD=sua-senha-app-gmail

# ============================================================================
# LOGGING
# ============================================================================

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# ============================================================================
# UPLOADS
# ============================================================================

# Tamanho máximo de upload (em MB)
MAX_UPLOAD_SIZE=50

# ============================================================================
# SESSION
# ============================================================================

# Tempo de sessão em horas
SESSION_TIMEOUT=8

# ============================================================================
# RATE LIMITING (quando implementado)
# ============================================================================

# RATE_LIMIT_LOGIN=5/15m  # 5 tentativas a cada 15 minutos

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================

# 1. Neste ambiente de desenvolvimento, os valores acima são apenas exemplos.
#    Em produção, TODOS os valores devem ser alterados e mantidos seguros.
#
# 2. O banco de dados postgres:13954@localhost é apenas para teste local.
#    Em produção, use credenciais de banco seguras.
#
# 3. SECRET_KEY e CHAVE_SECRETA_ADMIN devem ser valores aleatórios e únicos.
#
# 4. Nunca exponha este arquivo em repositórios públicos.
#
# 5. Use variáveis de ambiente do servidor (não .env) em produção.
#
# 6. Cada desenvolvedor pode ter seu próprio .env local com dados diferentes.

# ============================================================================
# GERAR CHAVES SEGURAS
# ============================================================================
# 
# No Python, execute:
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Ou no Linux/Mac:
#
#   openssl rand -hex 32
#
# Use a saída para SECRET_KEY e CHAVE_SECRETA_ADMIN

